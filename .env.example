# Copy this file to .env. The backend loads it at startup.
RECOMMENDER=rules
# Only api mode uses this key. Rules never make a network request.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
API_REQUESTS_PER_MINUTE=5
MAX_REQUEST_MB=22
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# VITE_API_URL is optional for separate hosting. It is public; never set a key here.
